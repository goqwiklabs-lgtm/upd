<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /

# Allow direct access to existing files and directories
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Clean P2P Join & Direct Transfer URLs (e.g. /p2p/7A89BF)
RewriteRule ^p2p/([a-zA-Z0-9_\-]+)/?$ index.php?join=$1 [L,QSA]
RewriteRule ^join/([a-zA-Z0-9_\-]+)/?$ index.php?join=$1 [L,QSA]

# Clean Google Drive & Public Sharable Links (e.g. /share/Agd82hwshufsAiheiidhcsi34f)
RewriteRule ^share/([a-zA-Z0-9_\-]+)/?$ share.php?token=$1 [L,QSA]
RewriteRule ^folder/([a-zA-Z0-9_\-]+)/?$ share.php?folder=$1 [L,QSA]

# Clean Temp Transfer Links (e.g. /temp/918274 or /t/918274)
RewriteRule ^temp/([a-zA-Z0-9_\-]+)/?$ temp.php?token=$1 [L,QSA]
RewriteRule ^t/([a-zA-Z0-9_\-]+)/?$ temp.php?token=$1 [L,QSA]

# Clean Admin route
RewriteRule ^admin/?$ admin.php [L,QSA]

</IfModule>
